# Entity: new

main: kit: entity: new: {

  alias: field: {}

  fields: {
    channels: {
      h: "Channels"
      n: "channels"
      r: false
      sh: "List of news channels this item is published on"
      t: "`$ARRAY`"
    }
    content: {
      h: "Content"
      n: "content"
      r: false
      sh: "Full HTML content of the news item"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the news item"
      t: "`$INTEGER`"
    }
    link: {
      fo: "uri"
      h: "Link"
      n: "link"
      r: false
      sh: "URL to the full news article"
      t: "`$STRING`"
    }
    published: {
      h: "Published"
      n: "published"
      r: false
      sh: "Publication date and time"
      t: "`$STRING`"
    }
    summary: {
      h: "Summary"
      n: "summary"
      r: false
      sh: "Brief summary of the news item"
      t: "`$STRING`"
    }
    title: {
      h: "Title"
      n: "title"
      r: false
      sh: "Title of the news item"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "new"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /news"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "after"
                or: "after"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "before"
                or: "before"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "What's New"
                k: "query"
                n: "channel"
                or: "channel"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 100
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "link"
                or: "link"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 0
                k: "query"
                n: "offset"
                or: "offset"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: false
                k: "query"
                n: "pretty"
                or: "pretty"
                r: false
                t: "`$BOOLEAN`"
              }
              {
                k: "query"
                n: "q"
                or: "q"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/news"
          q: {
            exist: [
              "after"
              "before"
              "channel"
              "limit"
              "link"
              "offset"
              "pretty"
              "q"
            ]
          }
          s: [
            {
              lit: "news"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /news/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: 40558
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/news/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "news"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
